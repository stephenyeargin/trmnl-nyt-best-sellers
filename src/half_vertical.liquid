{% if display == 'list' %}
<div class="layout layout--row">
  <div class="w--full" style="column-count: 1">
    {% for book in books limit: 10 %}
    <div class="item mb--1 lg:mb--6">
      <div class="meta w--5 lg:w--10">
    <span class="label label--small lg:label--large text-stroke">{{ book.rank }}</span>
      </div>
      <div class="content flex flex--row flex--stretch align--middle gap--medium">
        <div class="">
          <div><span class="label label--small lg:label--base label--underline" data-clamp="1">{{ book.title }}</span></div>
          <div>
            <span class="description description--base lg:description--large">
              {{ book.contributor }}
              {% if book.asterisk != 0 %}*{% endif %}
              {% if book.dagger != 0 %}&dagger;{% endif %}
            </span>
          </div>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
</div>
{% endif %}

{% if display == 'covers' %}
<div class="layout layout--row">
  <div class="grid grid--cols-2 gap--medium lg:gap--large w--full" style="height: 100%; grid-template-rows: repeat(2, minmax(0, 1fr));">
  {% for book in books limit: 4 %}
    <div style="display: flex; align-items: center; justify-content: center; min-width: 0; min-height: 0; height: 100%;">
      <div style="position: relative; display: flex; height: 100%; max-width: 100%;">
        <img src="{{ book.book_image }}" class="image image-dither" style="height: 100%; width: auto; max-width: 100%; object-fit: contain; filter: grayscale(1) contrast(1.2) brightness(1.1) saturate(0.8);" />
        <div style="position: absolute; bottom: 2px; right: 2px;"><span class="label label--small label--inverted h--5" style="border: solid 2px #ffffff;">#{{ book.rank }}</span></div>
      </div>
    </div>
  {% endfor %}
  </div>
</div>
{% endif %}

<div class="title_bar">
  <img class="image image-stroke" src="data:image/svg+xml;base64,{{ nyt_svg |  base64_encode }}" />
  <span class="title">{{ list }} for {{ list_date | date: '%B %-d, %Y' }}</span>
</div>
